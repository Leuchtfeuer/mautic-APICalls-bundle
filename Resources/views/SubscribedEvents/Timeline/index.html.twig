{% set properties = event.extra.properties %}

<div class="timeline-content">
    <h4 class="mb-8">Response Headers</h4>

    <pre>{% for key, values in properties.response_header %}
{{ key }}: {{ values|join(', ') }}
{% endfor %}
    </pre>
    <h4 class="mb-8">Response Body</h4>
    {% if properties.response_body_truncated is defined and properties.response_body_truncated %}
        <p class="text-muted small mb-8">{{ 'leuchtfeuer.mautic-apicalls-bundle.timeline.response_body_truncated'|trans({'%length%': properties.response_body_original_length}) }}</p>
    {% endif %}
    <pre>{{ properties.response_body }}</pre>
</div>